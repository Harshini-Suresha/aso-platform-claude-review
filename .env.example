# SMTP configuration for sending verification and report emails.
# Copy this file to backend/.env and fill in your real values.
# Without valid SMTP settings, emails fall back to console logging only.

# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rnatherapeuticsai@gmail.com
SMTP_PASS=your-app-password

# Sender address (no-reply)
SMTP_FROM=rnatherapeuticsai@gmail.com

# Frontend URL used in verification links
FRONTEND_URL=http://localhost:3000
